pipeline{
    agent any 
    
    stages{
        stage ("Welcome"){
            steps{
                echo 'Welcome'
                sh 'whoami'
                sh 'date'
                sh 'hostname'
            }
        }
        stage ('build'){
            steps{
                echo 'Application Builded'
                sh 'pwd'
                sh 'pyhton --version'
                sh 'python3 app.py'
            }
        }
    }
    post{
        success{
            echo 'pipeline is completed'
        }
        failure{
            echo 'pipeline failed'
        }
    }
}
